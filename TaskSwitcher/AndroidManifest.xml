    Simple Task Switcher for msm8909w
    Shows recent apps in a simple list view.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.qcom.taskswitcher">

    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.REMOVE_TASKS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="@string/app_name"
        android:hardwareAccelerated="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- Main task switcher activity -->
        <activity
            android:name=".TaskSwitcherActivity"
            android:label="@string/app_name"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:exported="true"
            android:theme="@style/TaskSwitcherTheme"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="com.qcom.taskswitcher.TOGGLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Receiver for recent apps toggle broadcast from PhoneWindowManager -->
        <receiver
            android:name=".MenuKeyReceiver"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.CLOSE_SYSTEM_DIALOGS" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
